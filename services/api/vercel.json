{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "main.py"
    }
  ],
  "functions": {
    "main.py": {
      "excludeFiles": "{tests/**,.pytest_cache/**,**/__pycache__/**,data/**,*.db}"
    }
  },
  "crons": [
    {
      "path": "/internal/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
